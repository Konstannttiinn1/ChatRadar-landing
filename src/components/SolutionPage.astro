---
import '../styles/global.css';
import '../styles/solutionPage.css';
import Footer from './Footer.astro';
import YandexMetrika from './YandexMetrika.astro';
import { site } from '../data/site';

const { solution } = Astro.props;
const canonicalUrl = `https://klyxon.app/solutions/${solution.slug}/`;
const pageTitle = `${solution.title} — KLYXON`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': `${canonicalUrl}#webpage`,
      url: canonicalUrl,
      name: pageTitle,
      description: solution.description,
      inLanguage: 'ru-RU',
      isPartOf: {
        '@id': 'https://klyxon.app/#website'
      }
    },
    {
      '@type': 'Service',
      '@id': `${canonicalUrl}#service`,
      name: solution.title,
      description: solution.description,
      url: canonicalUrl,
      provider: {
        '@id': 'https://klyxon.app/#organization'
      },
      areaServed: 'RU'
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'KLYXON',
          item: 'https://klyxon.app/'
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Решения для бизнеса',
          item: 'https://klyxon.app/#use-cases'
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: solution.kicker,
          item: canonicalUrl
        }
      ]
    }
  ]
};
---
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={solution.description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.svg?v=5" type="image/svg+xml" />

    <meta property="og:type" content="article" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:site_name" content="KLYXON" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={solution.description} />
    <meta property="og:url" content={canonicalUrl} />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={solution.description} />

    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <title>{pageTitle}</title>
  </head>
  <body class="solution-page">
    <YandexMetrika />
    <main>
      <section class="solution-top">
        <div class="container">
          <div class="solution-topbar">
            <a class="brand" href="/" aria-label="KLYXON — на главную">
              <span class="brand-mark"><span></span></span>
              <span>KLYXON</span>
            </a>
            <a class="solution-back" href="/#use-cases">← Все примеры применения</a>
          </div>

          <div class="solution-hero">
            <p class="section-kicker">{solution.kicker}</p>
            <h1>{solution.title}</h1>
            <p class="solution-hero-lead">{solution.intro}</p>

            {solution.sections && (
              <nav class="solution-section-nav" aria-label="Разделы автомобильного направления">
                {solution.sections.map((section) => (
                  <a href={`#${section.id}`}>
                    <span>{section.number}</span>
                    <strong>{section.title}</strong>
                  </a>
                ))}
              </nav>
            )}
          </div>
        </div>
      </section>

      <section class="solution-content">
        <div class="container">
          <nav class="solution-breadcrumbs" aria-label="Хлебные крошки">
            <a href="/">Главная</a>
            <span>→</span>
            <a href="/#use-cases">Решения для бизнеса</a>
            <span>→</span>
            <span>{solution.kicker}</span>
          </nav>

          <div class="solution-grid">
            <article class="solution-main">
              {solution.sections ? (
                <>
                  <section class="solution-overview">
                    <p class="section-kicker">Одна ниша — несколько задач</p>
                    <h2>Выберите подходящий сценарий</h2>
                    <p>
                      Автомобильное направление разделено на четыре практических сценария. Все они находятся на одной странице: можно перейти к нужному разделу через кнопки сверху или последовательно изучить примеры и настройки фильтрации.
                    </p>
                  </section>

                  {solution.sections.map((section) => (
                    <section class="solution-scenario" id={section.id}>
                      <div class="solution-scenario-head">
                        <span class="solution-scenario-number">{section.number}</span>
                        <span class="solution-scenario-icon" aria-hidden="true">{section.icon}</span>
                        <div>
                          <p class="section-kicker">Автомобильный сценарий</p>
                          <h2>{section.title}</h2>
                        </div>
                      </div>

                      <p class="solution-scenario-description">{section.description}</p>

                      <div class="solution-scenario-columns">
                        <div>
                          <h3>Какие запросы отслеживать</h3>
                          <ul class="solution-list">
                            {section.tasks.map((task) => <li>{task}</li>)}
                          </ul>
                        </div>

                        <div>
                          <h3>Примеры сообщений из чатов</h3>
                          <div class="solution-message-list">
                            {section.examples.map((example) => (
                              <div class="solution-message">
                                <span>Целевой запрос</span>
                                <p>«{example}»</p>
                              </div>
                            ))}
                          </div>
                        </div>
                      </div>

                      <div class="solution-filter">
                        <strong>Что можно исключить</strong>
                        <p>{section.filter}</p>
                      </div>
                    </section>
                  ))}

                  <section>
                    <p class="section-kicker">Пример настройки</p>
                    <h2>Как можно описать автомобильную задачу для LLM</h2>
                    <div class="solution-prompt">{solution.prompt}</div>
                  </section>
                </>
              ) : (
                <>
                  <section>
                    <p class="section-kicker">Какие задачи можно находить</p>
                    <h2>Реальные сценарии использования</h2>
                    <ul class="solution-list">
                      {solution.tasks.map((task) => <li>{task}</li>)}
                    </ul>
                  </section>

                  <section>
                    <p class="section-kicker">Примеры сообщений</p>
                    <h2>Что может попасть в уведомление</h2>
                    <div class="solution-message-list">
                      {solution.examples.map((example) => (
                        <div class="solution-message">
                          <span>Целевой запрос</span>
                          <p>«{example}»</p>
                        </div>
                      ))}
                    </div>
                  </section>

                  <section>
                    <p class="section-kicker">Смысловая фильтрация</p>
                    <h2>Как исключается шум</h2>
                    <div class="solution-filter">
                      <strong>Что может отсеять KLYXON</strong>
                      <p>{solution.filter}</p>
                    </div>
                  </section>

                  <section>
                    <p class="section-kicker">Пример настройки</p>
                    <h2>Как можно описать задачу для LLM</h2>
                    <div class="solution-prompt">{solution.prompt}</div>
                  </section>
                </>
              )}
            </article>

            <aside class="solution-sidebar">
              <div class="solution-side-card">
                <p class="section-kicker">Кому подходит</p>
                <h2>Компании и специалисты</h2>
                <div class="solution-audience">
                  {solution.audiences.map((audience) => <span>{audience}</span>)}
                </div>
              </div>

              <div class="solution-side-card solution-cta-card">
                <p class="section-kicker">Попробовать на своих чатах</p>
                <h2>Настройте поиск под свою задачу</h2>
                <p>Добавьте чаты, ключевые слова и правила смысловой фильтрации в Telegram-боте KLYXON.</p>
                <a class="button button-coral" href={site.botUrl} target="_blank" rel="noreferrer">Открыть KLYXON</a>
              </div>
            </aside>
          </div>
        </div>
      </section>
    </main>
    <Footer site={site} />
  </body>
</html>
