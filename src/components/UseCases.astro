---
import { solutionList } from '../data/solutions';
---
<section class="section section-light solutions-preview" id="use-cases">
  <div class="container">
    <div class="solutions-preview-inner">
      <div class="solutions-preview-copy">
        <p class="section-kicker">Решения для бизнеса</p>
        <h2>Примеры применения KLYXON</h2>
        <p class="muted">
          Сервис можно настроить под разные отрасли и типы запросов. На главной оставлены только короткие примеры, а подробные сценарии открываются на отдельных страницах.
        </p>
      </div>

      <div class="solutions-preview-grid">
        {solutionList.map((solution) => (
          <a class="solution-preview-card" href={`/solutions/${solution.slug}/`}>
            <span class="solution-preview-icon" aria-hidden="true">{solution.slug === 'logistics' ? '↗' : '⌘'}</span>
            <div>
              <h3>{solution.cardTitle}</h3>
              <p>{solution.cardDescription}</p>
              <strong>Посмотреть пример →</strong>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .solutions-preview {
    padding: 44px 0;
  }

  .solutions-preview-inner {
    display: grid;
    grid-template-columns: .82fr 1.18fr;
    gap: 28px;
    align-items: center;
    padding: 28px;
    border: 1px solid var(--line);
    border-radius: 26px;
    background: rgba(255, 255, 255, .54);
  }

  .solutions-preview-copy h2 {
    margin: 7px 0 10px;
    font-size: clamp(28px, 3vw, 40px);
  }

  .solutions-preview-copy p:last-child {
    margin: 0;
    line-height: 1.65;
  }

  .solutions-preview-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .solution-preview-card {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 14px;
    min-height: 172px;
    padding: 20px;
    border: 1px solid var(--line);
    border-radius: 18px;
    background: #fff;
    box-shadow: 0 12px 34px rgba(9, 20, 30, .04);
    transition: transform .2s ease, border-color .2s ease, box-shadow .2s ease;
  }

  .solution-preview-card:hover {
    transform: translateY(-3px);
    border-color: rgba(112, 198, 173, .65);
    box-shadow: 0 18px 44px rgba(9, 20, 30, .08);
  }

  .solution-preview-icon {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: #e7f2ef;
    color: #315f55;
    font-weight: 900;
  }

  .solution-preview-card h3 {
    margin: 1px 0 8px;
    font-size: 18px;
    line-height: 1.25;
  }

  .solution-preview-card p {
    margin: 0 0 14px;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.52;
  }

  .solution-preview-card strong {
    color: #1b6f5b;
    font-size: 13px;
  }

  @media (max-width: 900px) {
    .solutions-preview-inner {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 620px) {
    .solutions-preview {
      padding: 34px 0;
    }

    .solutions-preview-inner {
      padding: 20px;
      border-radius: 22px;
    }

    .solutions-preview-grid {
      grid-template-columns: 1fr;
    }

    .solution-preview-card {
      min-height: auto;
    }
  }
</style>
