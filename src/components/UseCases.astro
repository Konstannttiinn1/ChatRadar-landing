---
import { solutionList } from '../data/solutions';
---
<section class="section section-light solutions-preview" id="use-cases">
  <div class="container">
    <div class="solutions-preview-inner">
      <div class="solutions-preview-copy">
        <p class="section-kicker">Решения для бизнеса</p>
        <h2>Примеры применения KLYXON</h2>
        <p class="muted">
          Выберите направление — внутри собраны живые примеры сообщений, варианты фильтрации и сценарии работы для конкретной отрасли.
        </p>
        <span class="solutions-preview-hint">Выберите направление →</span>
      </div>

      <div class="solutions-preview-grid" aria-label="Примеры применения KLYXON">
        {solutionList.map((solution) => (
          solution.active ? (
            <a class="solution-preview-card" href={`/solutions/${solution.slug}/`}>
              <span class="solution-preview-icon" aria-hidden="true">{solution.icon}</span>
              <span class="solution-preview-text">
                <strong>{solution.cardTitle}</strong>
                <small>Смотреть пример →</small>
              </span>
            </a>
          ) : (
            <div class="solution-preview-card is-coming" aria-disabled="true">
              <span class="solution-preview-icon" aria-hidden="true">{solution.icon}</span>
              <span class="solution-preview-text">
                <strong>{solution.cardTitle}</strong>
                <small>Готовим пример</small>
              </span>
            </div>
          )
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .solutions-preview {
    padding: 44px 0;
  }

  .solutions-preview-inner {
    display: grid;
    grid-template-columns: .82fr 1.18fr;
    gap: 34px;
    align-items: center;
    padding: 32px;
    border: 1px solid var(--line);
    border-radius: 28px;
    background: rgba(255, 255, 255, .58);
    box-shadow: 0 18px 60px rgba(9, 20, 30, .04);
  }

  .solutions-preview-copy {
    max-width: 500px;
  }

  .solutions-preview-copy h2 {
    margin: 7px 0 13px;
    font-size: clamp(30px, 3.4vw, 46px);
    line-height: 1.08;
  }

  .solutions-preview-copy p {
    margin: 0;
    line-height: 1.68;
  }

  .solutions-preview-hint {
    display: inline-block;
    margin-top: 24px;
    color: #1b6f5b;
    font-size: 14px;
    font-weight: 800;
  }

  .solutions-preview-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
  }

  .solution-preview-card {
    display: flex;
    align-items: center;
    gap: 13px;
    min-height: 72px;
    padding: 12px 16px;
    border: 1px solid rgba(131, 216, 203, .24);
    border-radius: 16px;
    background: linear-gradient(135deg, #153b37, #0f2f2d);
    color: #fffdf8;
    box-shadow: 0 10px 28px rgba(7, 16, 24, .10);
    transition: transform .2s ease, border-color .2s ease, box-shadow .2s ease, background .2s ease;
  }

  a.solution-preview-card:hover {
    transform: translateY(-2px);
    border-color: rgba(131, 216, 203, .72);
    background: linear-gradient(135deg, #194942, #123733);
    box-shadow: 0 15px 34px rgba(7, 16, 24, .16);
  }

  .solution-preview-card.is-coming {
    border-color: rgba(49, 95, 85, .17);
    background: linear-gradient(135deg, #eaf1ed, #e2ebe6);
    color: #315f55;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, .42);
  }

  .solution-preview-icon {
    display: grid;
    place-items: center;
    flex: 0 0 42px;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: rgba(131, 216, 203, .15);
    color: #8ee4d4;
    font-size: 12px;
    font-weight: 900;
    letter-spacing: -.03em;
  }

  .is-coming .solution-preview-icon {
    background: rgba(49, 95, 85, .10);
    color: #4b796e;
  }

  .solution-preview-text {
    display: grid;
    gap: 3px;
    min-width: 0;
  }

  .solution-preview-text strong {
    font-size: 15px;
    line-height: 1.25;
  }

  .solution-preview-text small {
    color: #8ee4d4;
    font-size: 12px;
    font-weight: 800;
  }

  .solution-preview-card.is-coming small {
    color: #6f8c84;
  }

  @media (max-width: 900px) {
    .solutions-preview-inner {
      grid-template-columns: 1fr;
    }

    .solutions-preview-copy {
      max-width: 700px;
    }
  }

  @media (max-width: 620px) {
    .solutions-preview {
      padding: 34px 0;
    }

    .solutions-preview-inner {
      padding: 21px;
      border-radius: 22px;
    }

    .solutions-preview-grid {
      grid-template-columns: 1fr;
    }

    .solution-preview-card {
      min-height: 66px;
      padding: 10px 13px;
    }
  }
</style>
